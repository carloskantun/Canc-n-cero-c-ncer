# Sitio estático: no ejecutar scripts ni listar directorios.
Options -Indexes -ExecCGI
DirectoryIndex index.html
ErrorDocument 404 /404.html
<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|sql|env|ini|log)(\.|$)">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RewriteEngine On
# API independiente; el frontend usa directamente la URL segura.
RewriteRule ^api/(.*)$ https://cancuncerocancer-api.carloskantun.workers.dev/api/$1 [R=307,L,NE]
RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation)/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^cancuncerocancer\.com$ [NC]
RewriteRule ^ https://cancuncerocancer.com%{REQUEST_URI} [R=301,L,NE]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
